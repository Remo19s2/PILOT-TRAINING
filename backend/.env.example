APP_ENV=production
DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:5432/<database>
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:3001,http://localhost:3003
AUTO_CREATE_SCHEMA=false
SNS_BASE_URL=
SNS_API_KEY=
SNS_MASTER_WORKFLOW_ID=
SNS_MASTER_WORKFLOW_URL=https://api.agents.snsihub.ai/webhook-test/87fe434d-e381-4596-a4ef-53fc73a2f646
SNS_DECISION_WORKFLOW_ID=
SNS_NEGOTIATION_WORKFLOW_ID=
SNS_RISK_WORKFLOW_ID=
SNS_CALLBACK_URL=https://<render-service>.onrender.com/api/sns/webhook
SNS_WEBHOOK_SECRET=
SNS_WEBHOOK_SIGNATURE_HEADER=X-SNS-Signature
SNS_EXECUTION_URL_TEMPLATE=
SNS_TIMEOUT_SECONDS=15
