    {
      "id": "postgres.executeQuery-1789037579615001",
      "data": {
        "label": "Supply/Inventory SQL",
        "inputs": {
          "query": "SELECT\r\n    c.component_id,\r\n    c.component_code,\r\n    c.component_name,\r\n    c.criticality_profile,\r\n\r\n    -- Current inventory\r\n    COALESCE(inv.physical_stock, 0) AS physical_stock,\r\n    COALESCE(inv.reserved_stock, 0) AS reserved_stock,\r\n    COALESCE(inv.blocked_stock, 0) AS blocked_stock,\r\n    COALESCE(inv.safety_stock, 0) AS safety_stock,\r\n\r\n    (\r\n        COALESCE(inv.physical_stock, 0)\r\n        - COALESCE(inv.reserved_stock, 0)\r\n        - COALESCE(inv.safety_stock, 0)\r\n        - COALESCE(inv.blocked_stock, 0)\r\n    ) AS available_inventory,\r\n\r\n    inv.last_updated_at AS inventory_last_updated,\r\n\r\n    -- Incoming supply\r\n    COALESCE(supply.total_incoming_quantity, 0) AS total_incoming_quantity,\r\n    supply.next_expected_delivery_date,\r\n    supply.incoming_supply\r\n\r\nFROM components c\r\n\r\nLEFT JOIN LATERAL (\r\n    SELECT\r\n        SUM(i.physical_stock) AS physical_stock,\r\n        SUM(i.reserved_stock) AS reserved_stock,\r\n        SUM(i.blocked_stock) AS blocked_stock,\r\n        SUM(i.safety_stock) AS safety_stock,\r\n        MAX(i.last_updated_at) AS last_updated_at\r\n    FROM inventory i\r\n    WHERE i.component_id = c.component_id\r\n) inv ON true\r\n\r\nLEFT JOIN LATERAL (\r\n    SELECT\r\n        SUM(s.quantity) AS total_incoming_quantity,\r\n        MIN(s.expected_delivery_date) AS next_expected_delivery_date,\r\n\r\n        jsonb_agg(\r\n            jsonb_build_object(\r\n                'incoming_supply_id', s.incoming_supply_id,\r\n                'supplier_id', s.supplier_id,\r\n                'quantity', s.quantity,\r\n                'expected_delivery_date', s.expected_delivery_date,\r\n                'status', s.status,\r\n                'purchase_order_number', s.purchase_order_number\r\n            )\r\n            ORDER BY s.expected_delivery_date\r\n        ) AS incoming_supply\r\n\r\n    FROM incoming_supply s\r\n    WHERE s.component_id = c.component_id\r\n) supply ON true\r\n\r\nWHERE c.component_code = '{{$json.event_context.context.component_code}}';",
          "schema": "public",
          "tableMode": "list",
          "schemaMode": "list",
          "columnsMode": "manually",
          "idleTimeout": 0,
