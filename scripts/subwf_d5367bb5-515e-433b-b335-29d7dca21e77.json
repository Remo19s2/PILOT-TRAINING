      "id": "postgres.executeQuery-1788684174141001",
      "data": {
        "label": "Supplier Current status and History Status SQL",
        "inputs": {
          "query": "SELECT DISTINCT\r\n    s.supplier_id,\r\n    s.supplier_name\r\nFROM incoming_supply i\r\nJOIN suppliers s\r\n    ON s.supplier_id = i.supplier_id\r\nJOIN components c\r\n    ON c.component_id = i.component_id\r\nWHERE c.component_code = $1\r\n  AND i.supplier_id IS NOT NULL;",
          "schema": "public",
          "tableMode": "list",
          "schemaMode": "list",
          "columnsMode": "manually",
