    {
      "id": "postgres.executeQuery-1789538061709001",
      "data": {
        "label": "Supplier History SQL",
        "inputs": {
          "query": "SELECT\r\n    ssh.supplier_id,\r\n    ssh.status_timestamp,\r\n    ssh.operational_status,\r\n    ssh.delivery_status\r\nFROM supplier_status_history ssh\r\nWHERE ssh.supplier_id IN (\r\n    SELECT DISTINCT s.supplier_id\r\n    FROM incoming_supply s\r\n    JOIN components c\r\n        ON c.component_id = s.component_id\r\n    WHERE c.component_code = '{{$json.event_context.context.component_code}}'\r\n      AND s.supplier_id IS NOT NULL\r\n)\r\nORDER BY ssh.status_timestamp DESC\r\nLIMIT 20;",
          "schema": "public",
