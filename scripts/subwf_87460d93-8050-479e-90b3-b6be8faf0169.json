    {
      "id": "postgres.executeQuery-1788680930411014",
      "data": {
        "label": "BOM",
        "inputs": {
          "query": "SELECT\r\n    vm.vehicle_model_id,\r\n    vm.model_code,\r\n    vm.model_name,\r\n    vm.vehicle_category,\r\n    bh.bom_header_id,\r\n    bh.version_number,\r\n    bi.component_id,\r\n    bi.quantity AS component_quantity_required,\r\n    bi.procurement_type,\r\n    bi.is_procurement_relevant\r\nFROM bom_items bi\r\nJOIN bom_headers bh\r\n    ON bh.bom_header_id = bi.bom_header_id\r\nJOIN vehicle_models vm\r\n    ON vm.vehicle_model_id = bh.vehicle_model_id\r\nJOIN components c\r\n    ON c.component_id = bi.component_id\r\nWHERE c.component_code = $1\r\n  AND bh.status = 'ACTIVE'\r\n  AND bh.is_active = TRUE;",
          "schema": "public",
          "tableMode": "list",
          "schemaMode": "list",
