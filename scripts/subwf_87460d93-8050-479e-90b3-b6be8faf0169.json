    {
      "id": "postgres.executeQuery-1788681729308016",
      "data": {
        "label": "incoming supply order",
        "inputs": {
          "query": "SELECT\r\n    ins.incoming_supply_id,\r\n    s.supplier_code,\r\n    s.supplier_name,\r\n    c.component_code,\r\n    c.component_name,\r\n    ins.quantity,\r\n    ins.expected_delivery_date,\r\n    ins.status,\r\n    ins.purchase_order_number\r\nFROM incoming_supply ins\r\nJOIN suppliers s\r\n    ON s.supplier_id = ins.supplier_id\r\nJOIN components c\r\n    ON c.component_id = ins.component_id\r\nWHERE s.supplier_code = $1\r\n  AND c.component_code = $2\r\n  AND ins.status NOT IN ('RECEIVED', 'CANCELLED')\r\nORDER BY ins.expected_delivery_date ASC;",
          "schema": "public",
          "tableMode": "list",
          "schemaMode": "list",
          "columnsMode": "manually",
          "idleTimeout": 0,
          "credentialId": "bbbdb332-ae79-4355-9eaf-0f53c59954dd",
