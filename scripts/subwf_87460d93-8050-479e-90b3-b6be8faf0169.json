    {
      "id": "postgres.executeQuery-1788681281984015",
      "data": {
        "label": "customer order",
        "inputs": {
          "query": "SELECT\r\n    co.customer_order_id,\r\n    co.order_number,\r\n    co.customer_name,\r\n    co.order_date,\r\n    co.required_delivery_date,\r\n    co.priority_level,\r\n    co.status,\r\n    coi.customer_order_item_id,\r\n    coi.vehicle_model_id,\r\n    coi.quantity AS vehicle_quantity,\r\n    coi.unit_price\r\nFROM customer_orders co\r\nJOIN customer_order_items coi\r\n    ON coi.customer_order_id = co.customer_order_id\r\nWHERE coi.vehicle_model_id = $1\r\n  AND co.status = 'CONFIRMED'\r\nORDER BY\r\n    co.required_delivery_date ASC,\r\n    CASE co.priority_level\r\n        WHEN 'URGENT' THEN 1\r\n        WHEN 'HIGH' THEN 2\r\n        WHEN 'STANDARD' THEN 3\r\n        WHEN 'LOW' THEN 4\r\n        ELSE 5\r\n    END;",
          "schema": "public",
          "tableMode": "list",
          "schemaMode": "list",
          "columnsMode": "manually",
          "idleTimeout": 0,
          "credentialId": "bbbdb332-ae79-4355-9eaf-0f53c59954dd",
