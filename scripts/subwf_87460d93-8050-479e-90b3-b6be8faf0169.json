    {
      "id": "postgres.executeQuery-1788678043617013",
      "data": {
        "label": "inventory",
        "inputs": {
          "query": "SELECT\r\n    c.component_code,\r\n    c.component_name,\r\n    i.physical_stock,\r\n    i.reserved_stock,\r\n    i.safety_stock,\r\n    i.blocked_stock,\r\n    (\r\n        i.physical_stock\r\n        - i.reserved_stock\r\n        - i.safety_stock\r\n        - i.blocked_stock\r\n    ) AS available_inventory\r\nFROM inventory i\r\nJOIN components c\r\n    ON c.component_id = i.component_id\r\nWHERE c.component_code =$1;",
          "schema": "public",
          "tableMode": "list",
          "schemaMode": "list",
          "columnsMode": "manually",
